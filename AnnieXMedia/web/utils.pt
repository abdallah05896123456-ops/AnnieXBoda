# =========================================================
# 4. دوال النظام الأساسية (System Core Helpers)
# =========================================================

def run_async(coro):
    """تشغيل دوال البوت (Async) داخل بيئة (Sync) بأمان"""
    try:
        loop = asyncio.get_event_loop()
    except RuntimeError:
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
    
    if loop.is_running():
        return loop.create_task(coro)
    else:
        return loop.run_until_complete(coro)

# =========================================================
# 5. أدوات التنسيق والمعالجة (Formatters)
# =========================================================

def get_readable_size(size_in_bytes):
    """تحويل الحجم من بايت لـ MB/GB بدقة"""
    for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
        if size_in_bytes < 1024.0:
            return f"{size_in_bytes:.2f} {unit}"
        size_in_bytes /= 1024.0
    return f"{size_in_bytes:.2f} PB"

def format_duration(seconds):
    """تحويل الثواني لتنسيق 05:30 أو 1:20:45"""
    if not seconds: return "00:00"
    return str(timedelta(seconds=int(seconds)))

def is_safe_file(filename):
    """التحقق من أن الملف آمن (صوت أو فيديو فقط)"""
    ext = os.path.splitext(filename)[1].lower()
    return ext in Config.ALLOWED_EXTENSIONS

# =========================================================
# 6. الذاكرة المؤقتة (Simple Cache)
# =========================================================
# كلاس عشان نخزن فيه بيانات السيرفر بدل ما نحسبها كل مرة
class CacheManager:
    _cache = {}
    _expiry = {}

    @staticmethod
    def set(key, value, ttl=5):
        CacheManager._cache[key] = value
        CacheManager._expiry[key] = time.time() + ttl

    @staticmethod
    def get(key):
        if key in CacheManager._cache:
            if time.time() < CacheManager._expiry[key]:
                return CacheManager._cache[key]
        return None

# =========================================================
# 7. ديكوريتور الحماية (Security Guards)
# =========================================================

def sudo_required(f):
    """حماية الراوتات: يسمح فقط للمطور المسجل"""
    @wraps(f)
    def decorated_function(*args, **kwargs):
        if not session.get('is_sudo'):
            return jsonify({"error": "Access Denied", "reason": "Sudo Privileges Required"}), 403
        return f(*args, **kwargs)
    return decorated_function

def api_key_required(f):
    """(اختياري) حماية الراوتات بـ API Key للتطبيقات الخارجية"""
    @wraps(f)
    def decorated_function(*args, **kwargs):
        key = request.headers.get('X-API-KEY')
        if key != os.getenv("API_KEY"):
             return jsonify({"error": "Invalid API Key"}), 401
        return f(*args, **kwargs)
    return decorated_function
